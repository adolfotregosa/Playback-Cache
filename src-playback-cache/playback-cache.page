<?php
$pcsettings            = @parse_ini_file("/boot/config/plugins/playback-cache/playback-cache.cfg",true);
// playback cache
$pcsettings_media_folders        = isset($pcsettings['media_folders']) ? $pcsettings['media_folders'] : "";
$pcsettings_never_cache        = isset($pcsettings['never_cache']) ? $pcsettings['never_cache'] : "";
$pcsettings_cache_pool        = isset($pcsettings['cache_pool']) ? $pcsettings['cache_pool'] : "";
$pcsettings_wait_minutes        = isset($pcsettings['wait_minutes']) ? $pcsettings['wait_minutes'] : "";
// old installs stored seconds, this field counts minutes now, one old big value becomes minutes on first view
if ($pcsettings_wait_minutes > 59) { $pcsettings_wait_minutes = intval(round($pcsettings_wait_minutes / 60)); }
// legacy values like "copy" or "file" all mean Files in use, only "folder" is a real choice
$pcsettings_copy_scope        = (isset($pcsettings['copy_scope']) && $pcsettings['copy_scope'] == "folder") ? "folder" : "";
$pcsettings_skip_earlier_episodes        = isset($pcsettings['skip_earlier_episodes']) ? $pcsettings['skip_earlier_episodes'] : "";
// cache keepalive
$pcsettings_keep_hours        = isset($pcsettings['keep_hours']) ? $pcsettings['keep_hours'] : "";
$pcsettings_keep_hours_long        = isset($pcsettings['keep_hours_long']) ? $pcsettings['keep_hours_long'] : "";
$pcsettings_keep_long_folders        = isset($pcsettings['keep_long_folders']) ? $pcsettings['keep_long_folders'] : "";
// cache processing
$pcsettings_exclusion_list        = isset($pcsettings['exclusion_list']) ? $pcsettings['exclusion_list'] : "";
// Log
$pcsettings_log_to_syslog        = isset($pcsettings['log_to_syslog']) ? $pcsettings['log_to_syslog'] : "";
$pcsettings_notifications        = isset($pcsettings['notifications']) ? $pcsettings['notifications'] : "";
// Cron
$pcsettings_copy_cron        = isset($pcsettings['copy_cron']) ? $pcsettings['copy_cron'] : "";
$pcsettings_clean_cron        = isset($pcsettings['clean_cron']) ? $pcsettings['clean_cron'] : "";
// Cron rsync
$pcsettings_rsync_command        = isset($pcsettings['rsync_command']) ? $pcsettings['rsync_command'] : "";
// cache MediaServer
$pcsettings_mediaserver_type        = isset($pcsettings['mediaserver_type']) ? $pcsettings['mediaserver_type'] : "";
$pcsettings_mediaserver_host        = isset($pcsettings['mediaserver_host']) ? $pcsettings['mediaserver_host'] : "";
$pcsettings_mediaserver_port        = isset($pcsettings['mediaserver_port']) ? $pcsettings['mediaserver_port'] : "";
$pcsettings_mediaserver_key        = isset($pcsettings['mediaserver_key']) ? $pcsettings['mediaserver_key'] : "";
$pcsettings_path_mappings       = isset($pcsettings['path_mappings']) ? $pcsettings['path_mappings'] : "";
// dropdown of fixed values, a stored value that is not listed stays selectable
function sel($name, $value, $options, $extra = "") {
    if ($value != "" && !array_key_exists($value, $options)) { $options[$value] = $value; }
    $html = "<select name=\"".$name."\" style=\"width:auto;\"".$extra.">";
    foreach ($options as $option_value => $option_label) {
        $selected = ((string)$value === (string)$option_value) ? " selected" : "";
        $html .= "<option value=\"".htmlspecialchars($option_value)."\"".$selected.">".htmlspecialchars($option_label)."</option>";
    }
    return $html."</select>";
}
// what the crontab really holds, a stored state string can lie
function cron_friendly($cron) {
    $f = preg_split('/\s+/', trim($cron));
    if (count($f) != 5) { return $cron; }
    if ($f[1] == '*' && $f[2] == '*' && $f[3] == '*' && $f[4] == '*') {
        if (strpos($f[0], '*/') === 0) { return "every ".(int)substr($f[0], 2)." minutes"; }
        if (is_numeric($f[0])) { return "every hour at minute ".(int)$f[0]; }
    }
    if ($f[0] == '0' && $f[2] == '*' && $f[3] == '*' && $f[4] == '*' && ($f[1] == '*' || strpos($f[1], '*/') === 0)) {
        $n = $f[1] == '*' ? 1 : (int)substr($f[1], 2);
        return "every ".($n == 1 ? "hour" : $n." hours");
    }
    if ($f[2] == '*' && $f[3] == '*' && $f[4] == '*' && is_numeric($f[0]) && is_numeric($f[1])) {
        return "every day at ".sprintf("%02d:%02d", $f[1], $f[0]);
    }
    if ($f[2] == '*' && $f[3] == '*' && is_numeric($f[4]) && is_numeric($f[0]) && is_numeric($f[1])) {
        $days = array("Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday");
        $d = (int)$f[4] == 7 ? 0 : (int)$f[4];
        return "every ".$days[$d]." at ".sprintf("%02d:%02d", $f[1], $f[0]);
    }
    return $cron;
}
// handle switching needs gdb; the NerdTools gdb links against libpython3.12, so python3 must be installed too
$gdb_lines = array(); $gdb_rc = 1;
exec('PATH="$PATH:/usr/bin:/usr/local/bin:/bin" gdb --version 2>&1', $gdb_lines, $gdb_rc);
$gdb_out = trim(implode(" ", (array)$gdb_lines));
if ($gdb_rc === 0 && $gdb_out !== "") { $gdb_status = "ok"; }
elseif (strpos($gdb_out, "libpython") !== false) { $gdb_status = "nopython"; }
elseif ($gdb_out === "" || strpos($gdb_out, "not found") !== false) { $gdb_status = "missing"; }
else { $gdb_status = "broken"; }
// real mounted pools only: unRAID pools from emhttp, plus every /mnt/<name> mount on a real disk filesystem (ZFS included).
// The Unassigned Devices plugin tmpfs mounts (addons, remotes, rootshare) and fuse mounts are never targets.
$pool_options = array();
foreach ((array)@file("/var/local/emhttp/pools.ini") ?: array() as $ini_line) {
    if (preg_match('/^\[name="([^"]+)"/', $ini_line, $pool_match)) { $pool_options[$pool_match[1]] = $pool_match[1]; }
}
foreach ((array)@file("/proc/mounts") ?: array() as $mnt_line) {
    $mnt_f = preg_split('/\s+/', trim($mnt_line));
    if (count($mnt_f) < 3 || !preg_match('#^/mnt/([^/]+)$#', $mnt_f[1], $mnt_match)) { continue; }
    if (preg_match('/^(disk[0-9]+|user[0-9]*|disks)$/', $mnt_match[1]) || !preg_match('/^(zfs|btrfs|xfs|ext[234]|jfs|reiserfs|f2fs|ntfs|ntfs3|exfat)$/i', $mnt_f[2])) { continue; }
    $pool_options[$mnt_match[1]] = $mnt_match[1];
}
if (count($pool_options) == 0) { $pool_options["cache"] = "cache"; }
$cron_copy        = "Inactive";
$cron_clean        = "Inactive";
foreach (explode("\n", (string)shell_exec("crontab -l 2> /dev/null")) as $cron_line) {
    if (strpos($cron_line, "playback-cache/scripts/playback_cache") === false) { continue; }
    $cron_when = trim(preg_replace('/\s*\/usr\/local\/emhttp.*$/', '', $cron_line));
    if (strpos($cron_line, "playback_cache_copy") !== false) { $cron_copy = "Active: ".cron_friendly($cron_when); }
    if (strpos($cron_line, "playback_cache_clean") !== false) { $cron_clean = "Active: ".cron_friendly($cron_when); }
}
?>

<script>
    function showKind(p) {
        var kind = document.getElementById(p+"_kind").value;
        var parts = document.querySelectorAll("[data-kind='"+p+"']");
        for (var i = 0; i < parts.length; i++) {
            parts[i].style.display = (" "+parts[i].getAttribute("data-for")+" ").indexOf(" "+kind+" ") >= 0 ? "" : "none";
        }
    }
    function pad2(n) { return ("0"+n).slice(-2); }
    function fillPort() {
        var type = document.getElementById("mediaserver_type").value;
        var standard = {"jelly": "8096", "emby": "8096", "plex": "32400"};
        if (standard[type]) { document.getElementById("mediaserver_port").value = standard[type]; }
    }
    var pcRunning = [], pcCopying = [], pcTimer = null, pcFast = false;
    function pcFmt(epoch) {
        var d = new Date(epoch*1000), n = new Date();
        var hm = pad2(d.getHours()) + ":" + pad2(d.getMinutes());
        return d.toDateString() == n.toDateString() ? hm : (d.getMonth()+1) + "/" + d.getDate() + " " + hm;
    }
    function pcPct(text) {
        var m = text.match(/(\d+) of (\d+)/);
        return m ? " (" + Math.floor(m[1]*100/m[2]) + "%)" : "";
    }
    function pcUpdate(s) {
        var seg = { copy: "", clean: "" }, note = { copy: "", clean: "" }, job, j, copying = false, parts = [];
        pcRunning = []; pcCopying = [];
        for (var i = 0; i < 2; i++) {
            job = i == 0 ? "copy" : "clean";
            j = s[job];
            if (j.running) {
                pcRunning.push(job);
                // only real file work is worth a loud line, looking and waiting is not
                if (/^(file|folder) [0-9]+ of [0-9]+$/.test(j.text)) {
                    copying = true;
                    pcCopying.push(job);
                    seg[job] = (job == "copy" ? "Copying" : "Cleaning") + " - " + j.text + pcPct(j.text);
                }
                else if (!note[job]) { note[job] = /^waiting /.test(j.text) ? j.text : "checking"; }
            }
            else if (j.end) { seg[job] = "Last " + job + ": " + pcFmt(j.since) + " - " + j.text; }
        }
        // an extra belongs to the job that causes it, it must never drift to the end of
        // the strip and read like a message of the other job
        if (!copying) {
            for (var k = 0; k < 2; k++) {
                job = k == 0 ? "copy" : "clean";
                if (note[job]) { seg[job] = (seg[job] ? seg[job] + "   ·   " : (job == "copy" ? "Copy" : "Clean") + "   ·   ") + note[job]; }
            }
        }
        if (seg.copy) { parts.push(seg.copy); }
        if (seg.clean) { parts.push(seg.clean); }
        // the pipe keeps copy and clean apart, the dot stays for the trailing extras
        var txt = parts.length ? parts.join("   |   ") : "Nothing to copy";
        document.getElementById("pc_status").textContent = txt;
        // poll fast while something runs, lazy when idle
        var wantFast = pcRunning.length > 0;
        if (wantFast != pcFast) {
            pcFast = wantFast;
            if (pcTimer) { clearInterval(pcTimer); pcTimer = setInterval(pcPoll, wantFast ? 2000 : 4000); }
        }
        // buttons stay reachable while the script only looks around, a second start is refused politely
        document.getElementById("pc_run_copy").style.display = pcCopying.indexOf("copy") >= 0 ? "none" : "";
        document.getElementById("pc_run_clean").style.display = pcCopying.indexOf("clean") >= 0 ? "none" : "";
        // the script honours a cancel during the waiting time too, so the button is
        // reachable whenever any job runs, not only while bytes move
        document.getElementById("pc_cancel").style.display = pcRunning.length ? "" : "none";
    }
    function pcPoll() {
        if (document.hidden) { return; }
        fetch("/plugins/playback-cache/control.php?action=status", { cache: "no-store" }).then(function(r){ return r.json(); }).then(pcUpdate).catch(function(){});
    }
    function pcPost(body, done) {
        if (typeof csrf_token != "undefined") { body += "&csrf_token=" + encodeURIComponent(csrf_token); }
        fetch("/plugins/playback-cache/control.php", { method: "POST", cache: "no-store", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body })
            .then(function(r){ return r.json(); }).then(done).catch(function(){ document.getElementById("pc_status").textContent = "could not reach the plugin endpoint"; });
    }
    function pcRun(job) {
        pcPost("action=run&job=" + job, function(d){
            document.getElementById("pc_status").textContent = d.msg;
            pcPoll();
            // the script needs a moment to write its first state, poll fast until it shows up
            var tries = 0;
            var burst = setInterval(function() {
                pcPoll();
                if (pcRunning.length || ++tries > 6) { clearInterval(burst); }
            }, 1000);
        });
    }
    function pcCancel() {
        for (var i = 0; i < pcRunning.length; i++) { pcPost("action=cancel&job=" + pcRunning[i], function(d){}); }
        document.getElementById("pc_status").textContent = "cancel requested, stopping after the current file";
    }
    function testMediaServer() {
        var out = document.getElementById("test_result");
        var type = document.getElementById("mediaserver_type").value;
        var host = document.getElementById("mediaserver_host").value.trim();
        var port = document.getElementById("mediaserver_port").value.trim();
        var key = document.getElementById("mediaserver_key").value.trim();
        if (type == "") { out.className = "red"; out.textContent = "Pick a server type first"; return; }
        if (host == "" || port == "" || key == "") { out.className = "red"; out.textContent = "Fill host, port and key first"; return; }
        out.className = ""; out.textContent = "Testing...";
        var body = "type="+encodeURIComponent(type)+"&host="+encodeURIComponent(host)+"&port="+encodeURIComponent(port)+"&key="+encodeURIComponent(key);
        // unRAID rejects every POST without the page token, that is what answers with {"error":...}
        if (typeof csrf_token != "undefined") { body += "&csrf_token="+encodeURIComponent(csrf_token); }
        fetch("/plugins/playback-cache/test_server.php", { method: "POST", cache: "no-store", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: body })
        .then(function (r) { return r.text().then(function (txt) { return { status: r.status, txt: txt }; }); })
        .then(function (r) {
            var d = null;
            try { d = JSON.parse(r.txt); } catch (e) {}
            out.className = "red";
            if (d && typeof d.msg == "string") {
                out.className = d.ok ? "green" : "red";
                out.textContent = (d.ok ? "OK: " : "") + d.msg;
            } else if (d && typeof d.error == "string") {
                out.textContent = d.error;
            } else {
                out.textContent = r.status == 200 ? "unexpected answer: " + r.txt.replace(/[\r\n\t]+/g, " ").substring(0, 90) : "the web server answered HTTP " + r.status;
            }
        })
        .catch(function () { out.className = "red"; out.textContent = "the web server could not run the test"; });
    }
    function buildCron(p) {
        var kind = document.getElementById(p+"_kind").value;
        if (kind == "none") { return ""; }
        if (kind == "min") {
            var n = parseInt(document.getElementById(p+"_n").value);
            if (isNaN(n) || n < 1) { n = 10; }
            if (n > 59) { n = 59; }
            return "*/" + n + " * * * *";
        }
        if (kind == "hour") {
            var hn = parseInt(document.getElementById(p+"_n").value);
            if (isNaN(hn) || hn < 1) { hn = 12; }
            if (hn > 23) { hn = 23; }
            return "0 */" + hn + " * * *";
        }
        var t = document.getElementById(p+"_t").value;
        if (!/^\d{1,2}:\d{2}$/.test(t)) { t = "00:00"; }
        var h = parseInt(t.split(":")[0]) % 24, m = parseInt(t.split(":")[1]) % 60;
        if (kind == "day") { return m+" "+h+" * * *"; }
        return m+" "+h+" * * "+document.getElementById(p+"_d").value;
    }
    function setN(p, v) {
        document.getElementById(p+"_n").value = v;
    }
    function initSchedule(p, cron) {
        var kind = "none", f = (cron || "").trim().split(/\s+/);
        if ((cron || "").trim() && p == "copy" && f.length == 5 && f[1] == "*" && f[2] == "*" && f[3] == "*" && f[4] == "*" && /^\*\/\d+$/.test(f[0])) {
            setN(p, f[0].slice(2)); kind = "min";
        } else if ((cron || "").trim() && p == "copy" && f.join(" ") == "* * * * *") {
            setN(p, "1"); kind = "min";
        } else if ((cron || "").trim() && p != "copy" && f.length == 5 && f[0] == "0" && f[2] == "*" && f[3] == "*" && f[4] == "*" && (f[1] == "*" || /^\*\/\d+$/.test(f[1]))) {
            setN(p, f[1] == "*" ? "1" : f[1].slice(2)); kind = "hour";
        } else if ((cron || "").trim() && p != "copy" && f.length == 5 && f[2] == "*" && f[3] == "*" && f[4] == "*" && /^\d+$/.test(f[0]) && /^\d+$/.test(f[1])) {
            document.getElementById(p+"_t").value = pad2(f[1])+":"+pad2(f[0]); kind = "day";
        } else if ((cron || "").trim() && p != "copy" && f.length == 5 && f[2] == "*" && f[3] == "*" && /^\d$/.test(f[4]) && /^\d+$/.test(f[0]) && /^\d+$/.test(f[1])) {
            document.getElementById(p+"_t").value = pad2(f[1])+":"+pad2(f[0]);
            document.getElementById(p+"_d").value = f[4] == 7 ? "0" : f[4]; kind = "week";
        }
        // a schedule the boxes cannot show starts at "Not scheduled", the stored cron keeps
        // running untouched until APPLY ALL rewrites it from the form
        document.getElementById(p+"_kind").value = kind;
        showKind(p);
    }
    var copy_hints = {
        "": "Movie: the playing file plus subtitles and nfo. Series: the whole season folder.",
        "folder": "The whole folder of the playing file, subfolders included."
    };
    function showCopyHint() {
        var v = document.getElementById("copy_scope").value;
        document.getElementById("copy_hint").textContent = copy_hints[v] !== undefined ? copy_hints[v] : "";
    }
    function applyAll(command) {
        function pcNeed(el, msg) {
            if (el.value.replace(/[ ,]/g, "") == "") { alert(msg); el.focus(); return false; }
            return true;
        }
        // clearing the cron must work even with empty fields, clear just saves what is on screen
        if (command != "clear") {
            if (!pcNeed(document.querySelector("#cmform [name='media_folders']"), "Media subfolders is required: list at least one folder name, for example TvShows,Movies")) { return; }
            if (!pcNeed(document.getElementById("mediaserver_type"), "Pick a Media Server Type")) { return; }
            if (!pcNeed(document.getElementById("mediaserver_host"), "Address is required: the IP or hostname of the media server")) { return; }
            if (!pcNeed(document.getElementById("mediaserver_port"), "Port is required: it is filled in when you pick the Type")) { return; }
            if (!pcNeed(document.getElementById("mediaserver_key"), "API Key is required: the key of your media server")) { return; }
            if (document.getElementById("copy_kind").value == "min") {
                var cn = document.getElementById("copy_n").value;
                if (!/^\d+$/.test(cn) || +cn < 1 || +cn > 59) { alert("Copy schedule: every how many minutes? Use a whole number between 1 and 59"); document.getElementById("copy_n").focus(); return false; }
            }
            if (document.getElementById("clean_kind").value == "hour") {
                var hn = document.getElementById("clean_n").value;
                if (!/^\d+$/.test(hn) || +hn < 1 || +hn > 23) { alert("Cleaner schedule: every how many hours? Use a whole number between 1 and 23"); document.getElementById("clean_n").focus(); return false; }
            }
        }
        document.getElementById("cmcommand").value = "/usr/local/emhttp/plugins/playback-cache/scripts/cache_crons.sh";
        var arg = document.getElementById("cmarg");
        arg.value = (command == "clear") ? "clear" : "";
        // update.php runs #command through realpath, arguments only travel in #arg
        arg.disabled = (command != "clear");
        document.getElementById("copy_cron").value = buildCron('copy');
        document.getElementById("clean_cron").value = buildCron("clean");
        // rewrites are typed one per line, the settings file keeps them comma separated
        var rw = document.getElementById("path_mappings");
        var lines = rw.value.split("\n"), kept = [], i, line;
        for (i = 0; i < lines.length; i++) {
            line = lines[i].trim();
            if (line == "") { continue; }
            // a line the copy script would only warn about and skip is refused here,
            // it never gets saved to be silently ignored later, clear still just clears
            if (command != "clear") {
                if (line.indexOf(":") < 0) { alert("Mapping line '" + line + "' is not a source:target pair, it needs a : between the server path and the host path"); rw.focus(); return; }
                if (line.indexOf(":", line.indexOf(":") + 1) >= 0) { alert("Mapping line '" + line + "' looks like two mappings, use one line per mapping"); rw.focus(); return; }
            }
            kept.push(line);
        }
        rw.value = kept.join(",");
        document.getElementById("cmform").submit();
    }
</script>

